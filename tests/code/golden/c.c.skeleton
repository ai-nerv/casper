imports: [1-4]
  my_lib.h
  stdio.h

consts:
  MAX_SIZE 256 [5-6]
  VERSION "1.0" [6-7]

types:
  typedef struct Point [8-11]
    int x
    int y
  typedef enum Color [13-17]
    RED, GREEN, BLUE
  typedef unsigned int uint32 [19]
  struct Node [21-24]
    int value
    struct Node *next

fns:
  int add(int a, int b) [26-27]
  void process(const char *input, size_t len) [29]
  int main(int argc, char **argv) [31-33]
